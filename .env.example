# ================================
# OBRIGATÓRIO EM PRODUÇÃO
# ================================
# Validado no boot por src/config/env.ts: faltando qualquer uma, o processo
# encerra listando o que falta, em vez de subir quebrado ou inseguro.
#
# Sempre:
#   NODE_ENV              (development | test | production — precisa ser explícito)
#   DATABASE_URL
#   JWT_ACCESS_SECRET
#   JWT_TEMP_SECRET
#
# Adicionalmente com NODE_ENV=production:
#   JWT_ACCESS_SECRET     (mínimo 32 caracteres aleatórios)
#   JWT_TEMP_SECRET       (mínimo 32 caracteres, DIFERENTE do anterior)
#   FRONTEND_URL          (https://... — única origem liberada no CORS e base dos links de e-mail)
#   BREVO_API_KEY
#   EMAIL_FROM            (remetente verificado no Brevo)
#
# Por que NODE_ENV precisa ser explícito: qualquer valor diferente de
# "production" faz a API tratar o ambiente como desenvolvimento e liberar CORS
# para qualquer origem. Esquecer a variável no painel de deploy abriria a API.
#
# Por que os dois segredos precisam ser DIFERENTES: com o mesmo valor, um token
# temporário de cadastro tem assinatura válida como token de acesso.
# Gere cada um com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ================================
# BANCO DE DADOS
# ================================
DATABASE_URL="postgresql://usuario:senha@localhost:5432/minhaclinica"

# ================================
# SERVIDOR
# ================================
PORT=3001
NODE_ENV=development         # development | production

# ================================
# AUTENTICAÇÃO JWT
# ================================
# JWT_SECRET (legado) ainda funciona como fallback das duas variáveis abaixo,
# mas não use: um único segredo para acesso e cadastro é justamente o que
# permite um token temporário valer como sessão.
JWT_ACCESS_SECRET=sua_chave_secreta_muito_longa_e_aleatoria
JWT_TEMP_SECRET=outra_chave_secreta_para_tokens_temporarios

# ================================
# URLs
# ================================
FRONTEND_URL=http://localhost:5173   # URL do frontend (usada nos links dos emails)
APP_URL=http://localhost:3001        # URL pública do backend (usada para gerar links de uploads)

# ================================
# EMAIL — Gmail SMTP (desenvolvimento)
# ================================
# Guia: myaccount.google.com/security → Senhas de app
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ================================
# EMAIL — Brevo (produção)
# ================================
# 1. Crie conta em brevo.com
# 2. Vá em "SMTP & API" → "API Keys" → crie uma chave
# 3. Em "Senders" → adicione e verifique o remetente
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Minha Clínica <noreply@seudominio.com.br>
